
name: Label parser tests

on:
  push:
    branches:
      - feature/local-label-camera-ocr
    paths:
      - 'label-import.js'
      - 'tests/**'
      - '.github/workflows/label-parser-tests.yml'

  pull_request:
    paths:
      - 'label-import.js'
      - 'tests/**'
      - '.github/workflows/label-parser-tests.yml'

  workflow_dispatch:

permissions:
  contents: read

jobs:
  node-tests:
    name: Node.js parser tests
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Run label parser tests
        run: node --test tests/label-import.test.js
